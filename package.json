{
  "name": "clawhandoff",
  "version": "0.2.0",
  "description": "Universal local-first MCP bridge for verified multi-agent handoffs across OpenClaw (Gateway & Browser), Agent2Agent (A2A), Codex app-server, and Agent Client Protocol (ACP) with crash-safe SQLite reconciliation and checkout-free Git/PR gating.",
  "keywords": [
    "mcp",
    "a2a",
    "acp",
    "codex",
    "claude-code",
    "openclaw",
    "agent-handoff",
    "git-verification"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Mert Basar",
  "homepage": "https://github.com/MertBasar0/clawhandoff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MertBasar0/clawhandoff.git"
  },
  "bugs": {
    "url": "https://github.com/MertBasar0/clawhandoff/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "clawhandoff": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openclaw-plugin": {
      "types": "./dist/openclaw-plugin.d.ts",
      "default": "./dist/openclaw-plugin.js"
    }
  },
  "files": [
    "assets",
    "dist",
    "docs",
    "skills",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./dist/openclaw-plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.11.2",
      "pluginSdkVersion": "2026.11.2"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && tsc -p tsconfig.json && node --test \"dist-test/test/*.test.js\"",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
